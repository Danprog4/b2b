DATABASE_URL=postgres://postgres:postgres@localhost:5432/city_market

APP_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# S3-compatible file storage. Local /storage fallback is intentionally disabled.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Cloudflare R2 aliases are also accepted for the same S3-compatible storage.
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

INN_PROVIDER=dadata
INN_API_KEY=
DADATA_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=

# One-off production data transfer. Do not set these on Railway runtime service.
SOURCE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/city_market
TARGET_DATABASE_URL=
CONFIRM_PROD_DATA_IMPORT=
CONFIRM_TRUNCATE_NON_EMPTY_TARGET=

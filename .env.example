DATABASE_URL=postgres://postgres:postgres@localhost:5432/city_market

APP_URL=http://localhost:3000

# One-off production bootstrap. Set SEED_DEMO=1 on deploy/start to apply
# migrations, seed demo catalog data, upload demo images, then start the app.
# Remove SEED_DEMO after the successful production seed.
SEED_DEMO=
REPLACE_SEED_IMAGES=

EMAIL_PROVIDER=unisender_go
EMAIL_FROM="Сити Маркет <no-reply@example.ru>"
EMAIL_REPLY_TO=
EMAIL_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=5
EMAIL_WORKER_SECRET=
UNISENDER_GO_API_KEY=
UNISENDER_GO_API_BASE_URL=https://goapi.unisender.ru/ru/transactional/api/v1

# S3-compatible file storage. Local /storage fallback is intentionally disabled.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Cloudflare R2 aliases are also accepted for the same S3-compatible storage.
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

INN_PROVIDER=dadata
INN_API_KEY=
DADATA_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# One-off production data transfer. Do not set these on Railway runtime service.
SOURCE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/city_market
TARGET_DATABASE_URL=
DRY_RUN=
CONFIRM_PROD_DATA_IMPORT=
CONFIRM_TRUNCATE_NON_EMPTY_TARGET=
ALLOW_SAME_DATABASE_COPY=

# HTTP fallback for local -> Railway data import when the public Postgres proxy is unavailable.
# Set DATA_IMPORT_SECRET on Railway too; without it /api/admin/data-import returns 404.
TARGET_DATA_IMPORT_URL=https://example.up.railway.app/api/admin/data-import
DATA_IMPORT_SECRET=

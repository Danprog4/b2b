# Copy this file to .env.prod-seed and fill production values.
# Then run: bun run prod:seed-demo

# Production Postgres URL. Use Railway public proxy URL when running locally.
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Required safety flag for scripts/apply-prod-demo-content.ts.
CONFIRM_PROD_DEMO_SEED=YES

# Re-upload and relink demo images/banners even when files already exist.
REPLACE_SEED_IMAGES=YES

# S3-compatible storage used by production files.
# Use either S3_* or R2_* aliases; keep the unused group empty.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Cloudflare R2 aliases are accepted by the same storage code.
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
